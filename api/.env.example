# ===========================================================================
# PMS Environment Configuration — copy to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# --- API database user (LEAST PRIVILEGE: SELECT, INSERT, UPDATE, DELETE) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=pms_user
DB_PASS=change_me_strong_password
DB_GLOBAL_NAME=pms_global

# --- Privileged provisioning user (CREATE, ALTER, DROP for client DBs) ------
DB_ROOT_USER=pms_provisioner
DB_ROOT_PASS=change_me_provisioner_password

# --- Client DB naming ------------------------------------------------------
CLIENT_DB_PREFIX=pms_client_

# --- Tokens / passwords ----------------------------------------------------
TOKEN_TTL_SECONDS=3600
BCRYPT_COST=12

# --- Business --------------------------------------------------------------
DEFAULT_SERVICE_FEE=5.0

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60

# --- PayHero ---------------------------------------------------------------
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_CHANNEL_ID=133
PAYHERO_PROVIDER=m-pesa
PAYHERO_STK_URL=https://backend.payhero.co.ke/api/v2/payments?is_active=true
PAYHERO_CALLBACK_URL=https://yourdomain.com/api/webhook/payhero/callback
# Comma-separated IPs/CIDRs allowed to hit the callback. Empty = allow all (unsafe).
PAYHERO_ALLOWED_IPS=

# --- SMTP / mail -----------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=noreply@pms.co.ke
MAIL_FROM_NAME="PMS Notifications"

# --- CORS / public URLs ----------------------------------------------------
CORS_ALLOWED_ORIGIN=https://yourdomain.com
PUBLIC_BASE_URL=https://yourdomain.com
PAYMENT_PAGE_URL=https://yourdomain.com/pay
