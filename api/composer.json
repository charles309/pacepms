{
    "name": "pms/property-management-system",
    "description": "Multi-tenant Property Management System API (PHP 8.2, Apache, MySQL, PayHero).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "endroid/qr-code": "^5.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Pms\\": "src/"
        }
    }
}
